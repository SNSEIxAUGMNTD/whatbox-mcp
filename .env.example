# Copy these names into ~/.config/whatbox-mcp/local.env for local use.
# Never add real values to this repository or paste them into chat.
WHATBOX_HOST=
WHATBOX_USERNAME=
WHATBOX_SSH_PORT=22
WHATBOX_SSH_AUTH_MODE=agent
WHATBOX_SSH_KEY_PATH=
WHATBOX_SSH_KEY_PASSPHRASE=
WHATBOX_HOST_FINGERPRINT_SHA256=
WHATBOX_ALLOWED_ROOTS=
# Optional comma-separated local source directories allowed for static-site planning.
WHATBOX_WEBSITE_SOURCE_ROOTS=
